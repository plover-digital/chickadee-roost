{
  "openapi": "3.1.0",
  "info": {
    "title": "Chickadee Roost service API",
    "version": "1.1.0",
    "description": "Human GitHub onboarding creates named tokens at /settings/tokens. Repository coverage (full account including future repositories, or specific IDs) is independent of read/manage permissions. Manage includes read. Tokens default to read-only and 30 days with 1/7/30/90-day choices. Send Authorization: Bearer TOKEN; cookies do not authenticate the API. All operations are limited by current GitHub and App permissions. Full account organization policy and lifecycle operations require current verified organization ownership; specific tokens retain narrow legacy authority. GitHub schedules jobs; this API manages requested service state, not arbitrary VM execution. GET supports HEAD. Bounded beta lists have no pagination. See /agents.md."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "agentToken": []
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getIdentity",
        "summary": "Inspect token identity, name, scope, repositories and expiry",
        "description": "Requires read or manage scope. Repository-sensitive reads recheck current GitHub administration access.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "400": {
            "description": "Invalid documented JSON request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked token or GitHub reauthorization needed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scope, repository permission or foreign Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; see Allow header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub authorization or refresh unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Agent credential storage unavailable or capacity limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/queues": {
      "get": {
        "operationId": "listQueues",
        "summary": "List supported queue labels; not account enablement or idle capacity",
        "description": "Requires read or manage scope. Repository-sensitive reads recheck current GitHub administration access.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Queues"
                }
              }
            }
          },
          "400": {
            "description": "Invalid documented JSON request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked token or GitHub reauthorization needed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scope, repository permission or foreign Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; see Allow header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub authorization or refresh unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Agent credential storage unavailable or capacity limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/repositories": {
      "get": {
        "operationId": "listRepositories",
        "summary": "List currently administered repositories permitted by this token",
        "description": "Requires read or manage scope. Repository-sensitive reads recheck current GitHub administration access.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repositories"
                }
              }
            }
          },
          "400": {
            "description": "Invalid documented JSON request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked token or GitHub reauthorization needed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scope, repository permission or foreign Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; see Allow header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub authorization or refresh unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Agent credential storage unavailable or capacity limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/enrollments": {
      "get": {
        "operationId": "listEnrollments",
        "summary": "List this user\u2019s authorized service requests and applied state",
        "description": "Requires read or manage. Repository-sensitive reads recheck current GitHub access. Specific tokens exclude explicit organization policies. Full account tokens include canonical organization services only for a currently verified organization owner.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enrollments"
                }
              }
            }
          },
          "400": {
            "description": "Invalid documented JSON request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked token or GitHub reauthorization needed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scope, repository permission or foreign Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; see Allow header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub authorization or refresh unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Agent credential storage unavailable or capacity limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "requestEnrollment",
        "summary": "Create or update a repository\u2019s desired queue selection",
        "description": "Requires manage (includes read). Saved intent awaits reconciliation. Full account tokens may submit organization_access after current verified organization ownership; selected tokens may maintain only exact existing legacy organization queues. Workflow confirmations and App/backend permissions still apply. Maximum JSON body 32768 bytes; unknown fields rejected.",
        "responses": {
          "202": {
            "description": "Request accepted for reconciliation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid documented JSON request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked token or GitHub reauthorization needed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scope, repository permission or foreign Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; see Allow header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub authorization or refresh unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Agent credential storage unavailable or capacity limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Organization scope or manager conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Saving failed; inspect state before retrying",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "Exactly one JSON object; maximum 4096 bytes. Omitted queues requests only chickadee. Organization workflow path requirements depend on existing applied access and activation policy.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentRequest"
              },
              "example": {
                "installation_id": 8,
                "repository_id": 99,
                "queues": [
                  "chickadee"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/enrollments/{id}/state": {
      "post": {
        "operationId": "requestState",
        "summary": "Request activation/resume, pause or disconnection",
        "description": "Requires manage and current GitHub authority. Personal services require repository administration; organization lifecycle requires a full account token and current verified organization owner. Saves desired state without claiming applied capacity. Maximum body 4096 bytes.",
        "responses": {
          "202": {
            "description": "Request accepted for reconciliation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid documented JSON request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked token or GitHub reauthorization needed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient scope, repository permission or foreign Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; see Allow header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub authorization or refresh unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Agent credential storage unavailable or capacity limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Saving failed; inspect state before retrying",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "Opaque enrollment ID from listEnrollments"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StateRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "agentToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque chk_ token",
        "description": "Create through GitHub-authenticated browser settings; never use a GitHub PAT here."
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "login": {
            "type": "string"
          },
          "type": {
            "enum": [
              "User",
              "Organization"
            ]
          }
        },
        "required": [
          "id",
          "login",
          "type"
        ]
      },
      "Repository": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "full_name": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          },
          "permissions": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "id",
          "full_name",
          "private",
          "permissions"
        ]
      },
      "Installation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "app_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "permissions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "app_id",
          "account",
          "permissions"
        ]
      },
      "Enrollment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "installation_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "repository": {
            "$ref": "#/components/schemas/Repository"
          },
          "scope": {
            "enum": [
              "repository",
              "organization"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "active",
              "paused",
              "disconnected",
              "permission-required",
              "error"
            ]
          },
          "desired_state": {
            "enum": [
              "",
              "active",
              "paused",
              "disconnected"
            ]
          },
          "queues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled_queues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workflow_path": {
            "type": "string"
          },
          "enabled_workflow_path": {
            "type": "string"
          },
          "enabled_workflow_access": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "organization_access": {
            "$ref": "#/components/schemas/OrganizationAccess"
          },
          "applied_organization_access": {
            "$ref": "#/components/schemas/OrganizationAccess"
          }
        },
        "required": [
          "id",
          "installation_id",
          "repository",
          "scope",
          "status",
          "desired_state",
          "queues",
          "enabled_queues",
          "updated_at"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "accepted": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "status_url": {
            "const": "/api/v1/enrollments"
          }
        },
        "required": [
          "accepted",
          "message",
          "status_url"
        ]
      },
      "Identity": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              },
              "login": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "login"
            ]
          },
          "scope": {
            "enum": [
              "read",
              "manage"
            ]
          },
          "name": {
            "type": "string"
          },
          "repository_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "Specific repository IDs; empty for full account tokens."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "all_repositories": {
            "type": "boolean",
            "description": "True for full account access to all current and future GitHub-authorized repositories. False retains specific repository IDs."
          }
        },
        "required": [
          "user",
          "scope",
          "name",
          "repository_ids",
          "expires_at",
          "all_repositories"
        ]
      },
      "Queues": {
        "type": "object",
        "properties": {
          "default_queue": {
            "const": "chickadee"
          },
          "queues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "default_queue",
          "queues"
        ]
      },
      "Repositories": {
        "type": "object",
        "properties": {
          "automatic_activation": {
            "type": "boolean"
          },
          "repositories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "installation": {
                  "$ref": "#/components/schemas/Installation"
                },
                "repository": {
                  "$ref": "#/components/schemas/Repository"
                },
                "enrollment_notice": {
                  "type": "string"
                },
                "organization_admin": {
                  "type": "boolean",
                  "description": "Current verified organization owner membership. Does not expand a repository-scoped token."
                }
              },
              "required": [
                "installation",
                "repository"
              ]
            }
          }
        },
        "required": [
          "automatic_activation",
          "repositories"
        ]
      },
      "Enrollments": {
        "type": "object",
        "properties": {
          "enrollments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Enrollment"
            }
          }
        },
        "required": [
          "enrollments"
        ]
      },
      "EnrollmentRequest": {
        "type": "object",
        "properties": {
          "installation_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "repository_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "queues": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 8
          },
          "workflow_path": {
            "type": "string",
            "maxLength": 125
          },
          "organization_access": {
            "$ref": "#/components/schemas/OrganizationAccess"
          },
          "confirm_all_workflows": {
            "type": "boolean",
            "description": "Explicitly confirm all workflows when converting legacy organization policy whose workflow access is unknown. Requires organization_access and full account manage scope."
          }
        },
        "required": [
          "installation_id",
          "repository_id"
        ],
        "additionalProperties": false
      },
      "StateRequest": {
        "type": "object",
        "properties": {
          "state": {
            "enum": [
              "active",
              "paused",
              "disconnected"
            ]
          }
        },
        "required": [
          "state"
        ],
        "additionalProperties": false
      },
      "OrganizationAccess": {
        "type": "object",
        "description": "Explicit organization policy; full account tokens and current verified organization ownership required. Omitted workflows permits all workflows. Selected IDs and workflow repositories must be in the App installation.",
        "properties": {
          "repository_selection": {
            "enum": [
              "all",
              "selected"
            ]
          },
          "repository_ids": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          "workflows": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 300,
              "description": "owner/repo/.github/workflows/file.yml@refs/heads/main or a tag ref"
            }
          }
        },
        "required": [
          "repository_selection"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "repository_selection": {
                  "const": "selected"
                }
              }
            },
            "then": {
              "required": [
                "repository_ids"
              ],
              "properties": {
                "repository_ids": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "repository_ids": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
